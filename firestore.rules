rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'rigobertmumbere2018@gmail.com';
    }

    function isSupervisor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isActiveUser(uid) {
      return isAdmin() || isSupervisor()
        || (signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.active == true
          && get(/databases/$(database)/documents/users/$(uid)).data.role != 'supervisor');
    }

    function isActiveTaskOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(uid)).data.role != 'supervisor';
    }

    function isSupervisorUrgencyUpdate() {
      return isSupervisor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task', 'updatedAt'])
        && request.resource.data.task.diff(resource.data.task).affectedKeys()
          .hasOnly(['urgent', 'urgentBy', 'urgentAt'])
        && request.resource.data.task.urgent is bool
        && request.resource.data.deleted == resource.data.deleted;
    }

    // Lectures collectionGroup reservees a l'administration et a la supervision.
    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin() || isSupervisor();
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == isAdmin()
        && (isAdmin() || request.resource.data.role in ['member', 'supervisor']);

      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin() || isSupervisor());

      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'professions']));

      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isActiveUser(uid);
        allow create, delete: if isAdmin() || isActiveTaskOwner(uid);
        allow update: if isAdmin()
          || isActiveTaskOwner(uid)
          || isSupervisorUrgencyUpdate();
      }
    }
  }
}