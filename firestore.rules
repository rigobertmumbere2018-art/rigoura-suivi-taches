rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'rigobertmumbere2018@gmail.com';
    }
    function isActiveUser(uid) {
      return isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.active == true);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == isAdmin();
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read, create, update, delete: if isActiveUser(uid);
      }
    }
  }
}